@{
ViewData["Title"] = "Seal a Secret";
}

<style>
    body {
        background-color: #f4eacc;
        color: #3e2723;
        font-family: 'Georgia', serif;
    }

    .secret-container {
        max-width: 600px;
        margin: 50px auto;
        padding: 40px;
        background-color: #ebdcb2;
        border: 1px solid #d4c49d;
        border-radius: 4px;
        box-shadow: 2px 4px 15px rgba(0, 0, 0, 0.1);
    }

    .secret-title {
        text-align: center;
        font-weight: normal;
        border-bottom: 1px solid #c2b280;
        padding-bottom: 15px;
        margin-bottom: 25px;
        letter-spacing: 1px;
    }

    .secret-textarea {
        width: 100%;
        height: 200px;
        background-color: #fbf5e6;
        border: 1px solid #c2b280;
        border-radius: 4px;
        padding: 15px;
        box-sizing: border-box;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.04);
        outline: none;
        color: #3e2723;
        font-family: 'Courier New', Courier, monospace;
        font-size: 16px;
        resize: vertical;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .secret-textarea:focus {
        border-color: #8d6e63;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.04), 0 0 5px rgba(141, 110, 99, 0.3);
    }

    .secret-textarea::placeholder {
        color: #5d4037;
        opacity: 1;
        font-style: italic;
    }

    .secret-textarea::-webkit-input-placeholder {
        color: #5d4037;
        opacity: 1;
        font-style: italic;
    }

    .secret-textarea::-moz-placeholder {
        color: #5d4037;
        opacity: 1;
        font-style: italic;
    }

    .btn-seal {
        display: block;
        width: 100%;
        padding: 15px;
        background-color: #5d4037;
        color: #d7ccc8;
        border: none;
        font-size: 18px;
        cursor: pointer;
        transition: background-color 0.2s;
        margin-top: 20px;
        font-family: 'Georgia', serif;
        border-radius: 4px;
    }

    .btn-seal:hover {
        background-color: #3e2723;
    }

    .btn-seal:disabled {
        background-color: #8d6e63;
        cursor: not-allowed;
    }

    .result-box {
        display: none;
        margin-top: 20px;
        padding: 15px;
        background-color: #dfd0a6;
        border: 1px dashed #5d4037;
        border-radius: 4px;
    }

    .link-display {
        font-family: 'Courier New', Courier, monospace;
        background-color: #d4c49d;
        color: #bf360c;
        padding: 12px;
        margin: 15px 0;
        word-break: break-all;
        font-weight: bold;
        border-radius: 4px;
        border: 1px solid #c2b280;
        user-select: all;
    }

    .btn-copy {
        display: block;
        width: 100%;
        padding: 10px;
        background-color: #8d6e63;
        color: #fff;
        border: none;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.2s;
        font-family: 'Georgia', serif;
        border-radius: 4px;
    }

    .btn-copy:hover {
        background-color: #5d4037;
    }
</style>

<div class="secret-container">
    <h2 class="secret-title">Seal a Secret Note</h2>

    <div id="input-section">
        <textarea id="note-content" class="secret-textarea" placeholder="Write your secret here. It will be encrypted locally before leaving your browser..."></textarea>
        <button id="seal-btn" class="btn-seal" onclick="processSecret()">Seal & Get Link</button>
    </div>

    <div id="result-section" class="result-box">
        <p>Your secret is sealed. Share this link (it will only work once):</p>
        <div id="secret-link-display" class="link-display"></div>
        <button id="copy-btn" class="btn-copy" onclick="copyToClipboard()">Copy Link</button>
    </div>
</div>

<script>
    let generatedSecretUrl = "";

    async function processSecret() {
        // Оновлено селектори
        const content = document.getElementById('note-content').value;
        if (!content) return;

        const btn = document.getElementById('seal-btn');
        btn.disabled = true;
        btn.innerText = "Sealing...";

        try {
            const key = await crypto.subtle.generateKey(
                { name: "AES-GCM", length: 256 },
                true,
                ["encrypt", "decrypt"]
            );

            const encoder = new TextEncoder();
            const data = encoder.encode(content);
            const iv = crypto.getRandomValues(new Uint8Array(12));

            const encryptedBuffer = await crypto.subtle.encrypt(
                { name: "AES-GCM", iv: iv },
                key,
                data
            );

            const combined = new Uint8Array(iv.length + encryptedBuffer.byteLength);
            combined.set(iv, 0);
            combined.set(new Uint8Array(encryptedBuffer), iv.length);

            const base64Encrypted = btoa(String.fromCharCode(...combined));

            const response = await fetch('/secret', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ encryptedContent: base64Encrypted })
            });

            if (!response.ok) throw new Error("Server rejected the secret.");
            const result = await response.json();

            const rawKey = await crypto.subtle.exportKey("raw", key);
            const base64Key = btoa(String.fromCharCode(...new Uint8Array(rawKey)))
                .replace(/\+/g, '-')
                .replace(/\//g, '_')
                .replace(/=+$/, '');

            generatedSecretUrl = `${window.location.origin}/secret/${result.id}#${base64Key}`;

            // Оновлено селектори
            document.getElementById('input-section').style.display = 'none';
            const resultSection = document.getElementById('result-section');
            const linkDisplay = document.getElementById('secret-link-display');

            linkDisplay.innerText = generatedSecretUrl;
            resultSection.style.display = 'block';

        } catch (error) {
            console.error("Encryption failed:", error);
            alert("Failed to seal the secret.");
            btn.disabled = false;
            btn.innerText = "Seal & Get Link";
        }
    }

    async function copyToClipboard() {
        if (!generatedSecretUrl) return;

        try {
            await navigator.clipboard.writeText(generatedSecretUrl);

            // Оновлено селектор
            const copyBtn = document.getElementById('copy-btn');

            copyBtn.innerText = "Copied!";
            copyBtn.style.backgroundColor = "#3e2723";

            setTimeout(() => {
                copyBtn.innerText = "Copy Link";
                copyBtn.style.backgroundColor = "";
            }, 2000);

        } catch (err) {
            console.error('Failed to copy text: ', err);
            alert("Could not copy link automatically. Please select the text and copy manually.");
        }
    }
</script>
