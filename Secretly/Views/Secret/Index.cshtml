@{
    ViewData["Title"] = "Seal a Secret";
}

<style>
    /* Old parchment styling */
    body {
        background-color: #f4eacc; 
        color: #3e2723;
        font-family: 'Georgia', serif;
    }
    
    .secret-container {
        max-width: 600px;
        margin: 50px auto;
        padding: 40px;
        background-color: #ebdcb2;
        border: 1px solid #d4c49d;
        border-radius: 4px;
        box-shadow: 2px 4px 15px rgba(0, 0, 0, 0.1);
    }

    .secret-title {
        text-align: center;
        font-weight: normal;
        border-bottom: 1px solid #c2b280;
        padding-bottom: 15px;
        margin-bottom: 25px;
        letter-spacing: 1px;
    }

    .secret-textarea {
        width: 100%;
        height: 200px;
        background: transparent;
        border: none;
        outline: none;
        color: #3e2723;
        font-family: 'Courier New', Courier, monospace;
        font-size: 16px;
        resize: none;
    }

    .btn-seal {
        display: block;
        width: 100%;
        padding: 15px;
        background-color: #5d4037;
        color: #d7ccc8;
        border: none;
        font-size: 18px;
        cursor: pointer;
        transition: background-color 0.2s;
        margin-top: 20px;
        font-family: 'Georgia', serif;
    }

    .btn-seal:hover {
        background-color: #3e2723;
    }

    .result-box {
        display: none;
        margin-top: 20px;
        padding: 15px;
        background-color: #dfd0a6;
        border: 1px dashed #5d4037;
        word-break: break-all;
    }

    .result-link {
        color: #bf360c;
        font-weight: bold;
        text-decoration: none;
    }
</style>

<div class="secret-container">
    <h2 class="secret-title">Seal a Secret Note</h2>
    
    <div id="inputSection">
        <textarea id="noteContent" class="secret-textarea" placeholder="Write your secret here. It will be encrypted locally before leaving your browser..."></textarea>
        <button id="sealBtn" class="btn-seal" onclick="processSecret()">Seal & Get Link</button>
    </div>

    <div id="resultSection" class="result-box">
        <p>Your secret is sealed. Share this link (it will only work once):</p>
        <a id="secretLink" class="result-link" href="#" target="_blank"></a>
    </div>
</div>

<script>
    async function processSecret() {
        const content = document.getElementById('noteContent').value;
        if (!content) return;

        const btn = document.getElementById('sealBtn');
        btn.disabled = true;
        btn.innerText = "Sealing...";

        try {
            // 1. Generate AES-GCM Key (Client-side only)
            const key = await crypto.subtle.generateKey(
                { name: "AES-GCM", length: 256 },
                true,
                ["encrypt", "decrypt"]
            );

            // 2. Prepare data and Initialization Vector (IV)
            const encoder = new TextEncoder();
            const data = encoder.encode(content);
            const iv = crypto.getRandomValues(new Uint8Array(12));

            // 3. Encrypt data
            const encryptedBuffer = await crypto.subtle.encrypt(
                { name: "AES-GCM", iv: iv },
                key,
                data
            );

            // 4. Combine IV and Ciphertext for storage on the server
            const combined = new Uint8Array(iv.length + encryptedBuffer.byteLength);
            combined.set(iv, 0);
            combined.set(new Uint8Array(encryptedBuffer), iv.length);
            
            // Convert to Base64 string for easy JSON transport
            const base64Encrypted = btoa(String.fromCharCode(...combined));

            // 5. Send ONLY the encrypted data to our RESTful endpoint
            const response = await fetch('/secret', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ encryptedContent: base64Encrypted })
            });

            if (!response.ok) throw new Error("Server rejected the secret.");
            const result = await response.json();

            // 6. Export the secret key to embed it in the URL fragment
            const rawKey = await crypto.subtle.exportKey("raw", key);
            const base64Key = btoa(String.fromCharCode(...new Uint8Array(rawKey)))
                .replace(/\+/g, '-')
                .replace(/\//g, '_')
                .replace(/=+$/, ''); // Make Base64 URL-safe

            // 7. Construct final URL (Key is behind the '#' so the server never sees it)
            const finalUrl = `${window.location.origin}/secret/${result.id}#${base64Key}`;
            
            // Hide input, show result
            document.getElementById('inputSection').style.display = 'none';
            const resultSection = document.getElementById('resultSection');
            const linkElement = document.getElementById('secretLink');
            
            linkElement.href = finalUrl;
            linkElement.innerText = finalUrl;
            resultSection.style.display = 'block';

        } catch (error) {
            console.error("Encryption failed:", error);
            alert("Failed to seal the secret.");
            btn.disabled = false;
            btn.innerText = "Seal & Get Link";
        }
    }
</script>
