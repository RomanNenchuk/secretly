@{
    ViewData["Title"] = "Secret Not Found";
}

<style>
    body {
        background-color: #f4eacc;
        color: #3e2723;
        font-family: 'Georgia', serif;
    }

    .secret-container {
        max-width: 600px;
        margin: 50px auto;
        padding: 40px;
        background-color: #ebdcb2;
        border: 1px solid #d4c49d;
        border-radius: 4px;
        box-shadow: 2px 4px 15px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

    .secret-title {
        font-weight: normal;
        border-bottom: 1px solid #c2b280;
        padding-bottom: 15px;
        margin-bottom: 25px;
        letter-spacing: 1px;
        color: #bf360c;
    }

    .message-body {
        font-size: 18px;
        line-height: 1.6;
        margin-bottom: 30px;
        color: #5d4037;
    }

    .reasons-list {
        text-align: left;
        background-color: #fbf5e6;
        border: 1px solid #c2b280;
        padding: 20px 20px 20px 40px;
        border-radius: 4px;
        margin-bottom: 30px;
        font-family: 'Courier New', Courier, monospace;
        color: #3e2723;
    }

    .btn-home {
        display: inline-block;
        padding: 12px 25px;
        background-color: #5d4037;
        color: #d7ccc8;
        border: none;
        font-size: 16px;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.2s;
        font-family: 'Georgia', serif;
        border-radius: 4px;
    }

    .btn-home:hover {
        background-color: #3e2723;
        color: #fff;
    }
</style>

<div class="secret-container">
    <h2 class="secret-title">The Seal is Broken</h2>
    
    <div class="message-body">
        We could not find the secret note you are looking for. 
    </div>

    <ul class="reasons-list">
        <li>It has already been read and permanently destroyed.</li>
        <li>It expired and was burned.</li>
        <li>The link is incorrect.</li>
    </ul>

    <a href="/" class="btn-home">Create a New Secret</a>
</div>
