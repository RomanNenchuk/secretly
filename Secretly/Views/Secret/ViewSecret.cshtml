@model Secretly.Models.Entities.SecretNote
@{
    ViewData["Title"] = "Read Secret";
}

<style>
    body {
        background-color: #f4eacc;
        color: #3e2723;
        font-family: 'Georgia', serif;
    }

    .secret-container {
        max-width: 600px;
        margin: 50px auto;
        padding: 40px;
        background-color: #ebdcb2;
        border: 1px solid #d4c49d;
        border-radius: 4px;
        box-shadow: 2px 4px 15px rgba(0, 0, 0, 0.1);
    }

    .secret-title {
        text-align: center;
        font-weight: normal;
        border-bottom: 1px solid #c2b280;
        padding-bottom: 15px;
        margin-bottom: 25px;
        letter-spacing: 1px;
    }

    .secret-display {
        width: 100%;
        min-height: 200px;
        background-color: #fbf5e6;
        border: 1px solid #c2b280;
        border-radius: 4px;
        padding: 15px;
        box-sizing: border-box;
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.04);
        color: #3e2723;
        font-family: 'Courier New', Courier, monospace;
        font-size: 16px;
        white-space: pre-wrap;
        word-wrap: break-word;
        overflow-y: auto;
        display: none;
    }

    .status-message {
        text-align: center;
        font-style: italic;
        color: #5d4037;
        padding: 20px;
    }

    .error-box {
        display: none;
        margin-top: 20px;
        padding: 15px;
        background-color: #dfd0a6;
        border: 1px dashed #bf360c;
        color: #bf360c;
        border-radius: 4px;
        text-align: center;
        font-weight: bold;
    }

    .warning-text {
        text-align: center;
        color: #8d6e63;
        font-size: 14px;
        margin-top: 25px;
        font-style: italic;
    }
</style>

<meta id="secret-meta" data-encrypted="@Model.EncryptedContent" />
<div class="secret-container">
    <h2 class="secret-title">A Sealed Secret</h2>

    <div id="loading-msg" class="status-message">Breaking the seal and decrypting...</div>
    
    <div id="decrypted-content" class="secret-display"></div>
    
    <div id="error-msg" class="error-box"></div>

    <p class="warning-text">This note has been permanently destroyed from the server. If you refresh this page, it will be gone forever.</p>
</div>

<script>
    document.addEventListener("DOMContentLoaded", async () => {
        const loadingMsg = document.getElementById('loading-msg');
        const contentBox = document.getElementById('decrypted-content');
        const errorMsg = document.getElementById('error-msg');
        
        const metaTag = document.getElementById('secret-meta');
        const encryptedBase64 = metaTag.dataset.encrypted;

        try {
            const hash = decodeURIComponent(window.location.hash.substring(1)).trim();
            if (!hash) throw new Error("Missing encryption key in the URL.");

            let base64Key = hash.replace(/-/g, '+').replace(/_/g, '/');
            while (base64Key.length % 4) base64Key += '=';
            
            const rawKey = Uint8Array.from(atob(base64Key), c => c.charCodeAt(0));
            const key = await crypto.subtle.importKey(
                "raw",
                rawKey,
                { name: "AES-GCM" },
                false,
                ["decrypt"]
            );

            const combined = Uint8Array.from(atob(encryptedBase64), c => c.charCodeAt(0));
            
            const iv = combined.slice(0, 12);
            const data = combined.slice(12);

            const decryptedBuffer = await crypto.subtle.decrypt(
                { name: "AES-GCM", iv: iv },
                key,
                data
            );

            loadingMsg.style.display = 'none';
        contentBox.innerText = new TextDecoder().decode(decryptedBuffer);
            contentBox.style.display = 'block';

            history.replaceState(null, null, ' ');

        } catch (error) {
            console.error("Decryption failed:", error);
            loadingMsg.style.display = 'none';
            errorMsg.innerText = "Failed to decrypt. The key might be invalid or the URL is corrupted.";
            errorMsg.style.display = 'block';
        }
    });
</script>
